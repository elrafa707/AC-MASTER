# Servidor
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS, separados por coma (la app móvil no lo necesita)
CORS_ORIGINS=

# SQL Server (docker-compose de la raíz)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=AcMaster_Dev2026!
DB_NAME=ACMaster
DB_TRUST_CERT=true

# Autenticación (genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# Carpeta donde se guardan las fotos (no se sube a git)
UPLOADS_DIR=./uploads

# Asistente de diagnóstico con IA (etapa 2)
# - Con ANTHROPIC_API_KEY el asistente usa Claude y analiza las fotos.
# - Sin clave funciona en modo "simulado" (reglas locales, no analiza fotos), útil para desarrollar.
# Cada integrante usa su propia clave; NUNCA la subas al repositorio.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ASISTENTE_MODO=simulado

# Etapas siguientes
# FIREBASE_CREDENTIALS=./firebase-service-account.json
